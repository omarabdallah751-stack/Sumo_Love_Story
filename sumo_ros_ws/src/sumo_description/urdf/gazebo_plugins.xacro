<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- 1. Differential Drive Plugin -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <!-- Left Wheels -->
            <left_joint>wheel1_joint</left_joint>
            <left_joint>wheel2_joint</left_joint>
            
            <!-- Right Wheels -->
            <right_joint>wheel_joint</right_joint>
            <right_joint>wheel3_joint</right_joint>
            
            <!-- Kinematics -->
            <wheel_separation>0.242</wheel_separation>
            <wheel_radius>0.032</wheel_radius>
            
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint_link</child_frame_id>
            <odom_publish_frequency>50</odom_publish_frequency>
        </plugin>
    </gazebo>

    <!-- 2. Joint State Publisher Plugin -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
            <joint_name>wheel_joint</joint_name>
            <joint_name>wheel1_joint</joint_name>
            <joint_name>wheel2_joint</joint_name>
            <joint_name>wheel3_joint</joint_name>
            <joint_name>axe_joint</joint_name>
        </plugin>
    </gazebo>

</robot>